# Copy to .env.local for local runs (git-ignored). On Vercel set the same names in Settings > Environment Variables
# (Production, Preview, Development). Placeholders only: never put a real password in this file.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/changachett?retryWrites=true&w=majority
MONGODB_DB=changachett
# Long random string (at least 16 characters), e.g. from: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
# Highest believable score per wave reached (default 5000). A run with score > wave * this is rejected.
MAX_SCORE_PER_WAVE=5000
# Local only, if Node cannot resolve mongodb+srv (querySrv ECONNREFUSED): public DNS servers to use. Not needed on Vercel.
# DNS_SERVERS=8.8.8.8,1.1.1.1
